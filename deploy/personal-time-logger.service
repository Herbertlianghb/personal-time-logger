[Unit]
Description=Personal time logger evidence receiver
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=time-logger
Group=time-logger
WorkingDirectory=/opt/personal-time-logger
ExecStart=/opt/personal-time-logger/.venv/bin/python -m time_logger --config /var/lib/personal-time-logger/config.json serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-time-logger
MemoryHigh=240M
MemoryMax=320M
CPUQuota=50%
TasksMax=32
LogNamespace=personal-time-logger
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
