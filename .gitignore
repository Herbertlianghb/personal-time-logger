# Historical private delivery materials share this local directory.
# Use deploy/export-source.py to export a public source archive.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/LICENSE.md
!/desktop_entry.py
!/requirements.lock.txt
!/requirements.desktop.lock.txt
!/time_logger/
!/tests/
!/config/
!/docs/
!/deploy/
/time_logger/*
!/time_logger/*.py
/tests/*
!/tests/*.py
!/tests/controlled-corpus.json
/config/*
!/config/config.example.json
!/config/client.example.json
!/config/device.example.json
!/config/ssh-config.example
!/config/field-contract.example.json
!/config/model-proposal.schema.json
!/config/interpreter-prompt.txt
/docs/*
!/docs/SETUP.md
!/docs/SERVER.md
!/docs/CONFIGURATION.md
!/docs/AGENT-SETUP.md
!/docs/AGENT-PROMPTS.md
!/docs/DISTRIBUTION.md
!/docs/RELEASE-1.4.7.md
/deploy/*
!/deploy/build-desktop.ps1
!/deploy/package-desktop.py
!/deploy/install-desktop.ps1
!/deploy/install.vbs
!/deploy/install-client-task.ps1
!/deploy/install_units.py
!/deploy/provision-desktop.py
!/deploy/set_flags.py
!/deploy/set-desktop-options.py
!/deploy/generate-desktop-icon.py
!/deploy/desktop-version.txt
