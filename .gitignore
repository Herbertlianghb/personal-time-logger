!/deploy/personal-time-logger-backup.service
!/deploy/personal-time-logger-backup.timer
!/deploy/journal-limits.conf
!/deploy/export-source.py
!/deploy/licenses/
**/__pycache__/
**/*.py[cod]
**/*.sqlite3*
**/*.db
**/*.log
**/.env*
**/*private*
**/device.json
**/client-config.json
**/server-config.json
**/known_hosts
